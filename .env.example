PORT=8080
# Set to your public HTTPS origin before launch, without trailing slash.
PUBLIC_ORIGIN=http://localhost:8080
# Set true behind an HTTPS reverse proxy (production).
COOKIE_SECURE=false
DATA_DIR=./data
MAX_VIDEO_MB=4096

# Email OTP: set credentials only in .env, never commit them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
